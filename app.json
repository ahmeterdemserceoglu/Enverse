{
  "expo": {
    "name": "Enverse",
    "slug": "enverse",
    "version": "0.3.1",
    "icon": "./assets/icon.png",
    "scheme": "enverse",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.enverse.app"
    },
    "android": {
      "package": "com.enverse.app",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAFAF9"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "QUERY_ALL_PACKAGES",
        "REQUEST_INSTALL_PACKAGES"
      ]
    },
    "plugins": ["./plugins/withLauncherQueries.js"],
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    }
  }
}
